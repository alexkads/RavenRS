# The socket the plugin explain of Raven CI asks for the explanation of a failed build (#942). Each
# connection starts an instance of raven-ci-explicador@.service of its own (Accept=yes), with the
# connection as its input and output: one line of JSON in, one out.
[Unit]
Description=Raven CI, explicação das falhas com IA local
Documentation=https://github.com/alexkads/RavenRS/tree/master/tools/raven-ci/docs/ai.md

[Socket]
ListenStream=/run/raven-ci/explicador.sock
Accept=yes
SocketUser=raven-ci
SocketGroup=raven-ci
SocketMode=0600
DirectoryMode=0755
MaxConnections=2

[Install]
WantedBy=sockets.target
