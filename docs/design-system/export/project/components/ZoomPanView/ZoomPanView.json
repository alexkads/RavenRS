nPaint, scene: &mut Scene| {\n        // ravenrs-lint: allow(raw_color) the stand-in photograph being zoomed: its colors are the content\n        scene.push_quad(Quad::new(frame.placed, Color::rgb(0.16, 0.3, 0.5)));\n        let side = 120.0 * frame.scale;\n        // ravenrs-lint: allow(raw_color) the stand-in photograph being zoomed: its colors are the content\n        for (i, color) in [Color::rgb(0.9, 0.45, 0.3), Color::rgb(0.95, 0.8, 0.3)].into_iter().enumerate() {\n            let x = frame.placed.x() + frame.placed.width() * (0.2 + 0.4 * i as f32);\n            let y = frame.placed.y() + frame.placed.height() * 0.35;\n            scene.push_quad(Quad::new(Rect::new(x, y, side, side), color).radius(side / 2.0));\n        }\n    };\n    VStack::new((\n        ZoomControl::new(view.binding()),\n        ZoomPanView::custom(view.binding(), content, picture).size(420.0, 200.0).label(\"Sample picture\"),\n    ))\n    .spacing(8.0)\n}","component":"ZoomPanView","family":"Media","id":"media--zoompanview","interaction":{"Focus":{"changes":[{"added":{"border":{"color":"focus-ring","width":2.0},"fill":"transparent","kind":"rect","radius":[15.0,15.0,15.0,15.0],"rect":[-5.0,-5.0,50.0,42.0]}}],"control":"Fit","dark":{"paint":[{"border":{"color":"accent@55","width":1.0},"fill":"accent@18","kind":"rect","radius":[10.0,10.0,10.0,10.0],"rect":[0.0,0.0,40.0,32.0]},{"baseline":20.73,"color":"mix(ink, accent, 30)","font":"Inter","kind":"text","size":13.0,"text":"Fit","weight":600,"x":[12.0,19.64,23.04]},{"border":{"color":"focus-ring","width":2.0},"fill":"transparent","kind":"rect","radius":[15.0,15.0,15.0,15.0],"rect":[-5.0,-5.0,50.0,42.0]},{"fill":"transparent","kind":"rect","radius":[10.0,10.0,10.0,10.0],"rect":[44.0,0.0,40.0,32.0]},{"baseline":20.73,"color":"ink","font":"Inter","kind":"text","size":13.0,"text":"11","weight":600,"x":[56.0,61.5,65.64]},{"fill":"border","kind":"rect","radius":[0.0,0.0,0.0,0.0],"rect":[88.0,8.0,1.0,16.0]},{"fill":"transparent","kind":"rect","radi