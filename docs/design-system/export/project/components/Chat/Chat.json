ght(380.0).width(420.0))\n        }\n    }\n    Conversation\n}","component":"Chat","family":"Forms","id":"forms--chat","interaction":{"Focus":{"changes":[{"added":{"border":{"color":"focus-ring","width":2.0},"fill":"transparent","kind":"rect","radius":[15.0,15.0,15.0,15.0],"rect":[-5.0,51.0,129.0,42.0]}}],"control":"How do I start?","dark":{"paint":[{"kind":"clip","rect":[0.0,0.0,413.0,328.0]},{"baseline":21.73,"color":"ink-muted","font":"Inter","kind":"text","size":13.0,"text":"It does not know who answers: yours adds to the messages, now ","weight":400,"x":[0.0,3.68,7.93,11.59,19.55,27.35,34.92,41.79,45.44,53.12,60.92,65.17,68.83,75.96,83.64,91.2,101.84,105.5,116.14,123.82,131.62,135.27,142.57,150.26,157.12,167.52,175.1,179.99,186.86,190.6,194.26,201.31,209.1,216.79,221.69,228.55,232.2,239.5,247.46,255.42,262.29,265.94,270.07,277.86,281.52,285.77,293.46,301.04,304.69,316.08,323.66,330.52,337.38,344.68,352.66,360.24,367.1,370.84,374.5,382.18,389.74,400.38]},{"baseline":39.73,"color":"ink-muted","font":"Inter","kind":"text","size":13.0,"text":"or later.","weight":400,"x":[0.0,7.79,12.69,16.35,19.49,26.79,30.92,38.5,42.58]},{"border":{"color":"border","width":1.0},"fill":"bg-300","kind":"rect","radius":[10.0,10.0,10.0,10.0],"rect":[0.0,56.0,119.0,32.0]},{"baseline":76.73,"color":"ink","font":"Inter","kind":"text","size":13.0,"text":"How do I start?","weight":600,"x":[12.0,21.69,29.41,40.32,43.6,51.71,59.63,62.9,66.5,69.78,76.92,81.57,89.04,94.43,99.02]},{"border":{"color":"focus-ring","width":2.0},"fill":"transparent","kind":"rect","radius":[15.0,15.0,15.0,15.0],"rect":[-5.0,51.0,129.0,42.0]},{"border":{"color":"border","width":1.0},"fill":"bg-300","kind":"rect","radius":[10.0,10.0,10.0,10.0],"rect":[127.0,56.0,149.0,32.0]},{"baseline":76.73,"color":"ink","font":"Inter","kind":"text","size":13.0,"text":"Where are my files?","weight":600,"x":[139.0,152.26,160.22,167.91,172.78,180.47,183.74,191.21,196.08,203.77,207.05,218.54,226.19,229.46,234.59,237.99,241.39,249.08,2