draws the frame.\", 0.66, 2.0),\n    ));\n    ScrollView::new((\n        Text::new(\"Scroll down: the scene holds while its steps change.\").foreground(Semantic::InkMuted),\n        ScrollScene::new(steps).length(600.0),\n        Text::new(\"Here the scene lets go.\").foreground(Semantic::InkMuted),\n        Canvas::new(|_, _| {}).size(10.0, 200.0),\n    ))\n    .spacing(12.0)\n    .height(280.0)\n}","component":"ScrollScene","family":"Layout","id":"layout--scrollscene","interaction":null,"pending":false,"sizing":{"height":"hug","max_width":null,"min_width":null,"narrows_to":266.0,"reflows":false,"sizes":{"1200":[370.0,280.0],"320":[266.0,280.0],"760":[370.0,280.0]},"stretches":true,"width":"hug"},"stories":[{"args":{"length":600.0,"top":0.0},"id":"layout--scrollscene--example","name":"Example","sizing":{"height":"hug","max_width":null,"min_width":null,"narrows_to":266.0,"reflows":false,"sizes":{"1200":[370.0,280.0],"320":[266.0,280.0],"760":[370.0,280.0]},"stretches":true,"width":"hug"},"themes":{"dark":{"paint":[{"kind":"clip","rect":[0.0,0.0,370.0,280.0]},{"baseline":16.46,"color":"ink-muted","font":"Inter","kind":"text","size":15.0,"text":"Scroll down: the scene holds while its steps change.","weight":400,"x":[0.0,9.62,18.19,23.59,32.59,36.22,39.85,44.07,53.25,61.98,74.25,83.12,87.44,91.66,96.56,105.43,114.18,118.4,126.31,134.88,143.63,152.49,161.24,165.45,174.32,183.32,186.95,196.14,204.05,208.27,220.55,229.42,233.05,236.68,245.43,249.65,253.28,258.04,265.96,270.18,278.09,282.85,291.6,300.78,308.7,312.92,321.49,330.36,338.78,347.64,356.84,365.59]},{"border":{"color":"border","width":1.0},"fill":"bg-200","kind":"rect","radius":[24.0,24.0,24.0,24.0],"rect":[0.0,34.0,370.0,106.0],"shadow":{"blur":24.0,"color":"scrim@70","x":0.0,"y":8.0}},{"baseline":80.0,"color":"ink","font":"Inter","kind":"text","size":22.0,"text":"1. State","weight":600,"x":[24.0,33.3,39.87,45.41,59.72,67.59,80.22,87.78]},{"baseline":110.46,"color":"ink-muted","font":"Inter","kind":"text","size"