        }),\n        Text::new(\"Click: foreground. Cmd or Ctrl and click: background.\").style(TextStyle::Caption),\n    ))\n    .spacing(8.0)\n}","component":"SwatchGrid","family":"Actions and inputs","id":"actions-and-inputs--swatchgrid","interaction":{"Focus":{"changes":[{"added":{"border":{"color":"focus-ring","width":2.0},"fill":"transparent","kind":"rect","radius":[10004.0,10004.0,10004.0,10004.0],"rect":[-5.0,-5.0,42.0,42.0]}}],"control":"Rose","dark":{"paint":[{"fill":"transparent","kind":"rect","radius":[9999.0,9999.0,9999.0,9999.0],"rect":[0.0,0.0,32.0,32.0]},{"border":{"color":"accent","width":2.5},"fill":"#e11d48","kind":"rect","radius":[10.0,10.0,10.0,10.0],"rect":[6.0,6.0,20.0,20.0]},{"border":{"color":"focus-ring","width":2.0},"fill":"transparent","kind":"rect","radius":[10004.0,10004.0,10004.0,10004.0],"rect":[-5.0,-5.0,42.0,42.0]},{"fill":"transparent","kind":"rect","radius":[9999.0,9999.0,9999.0,9999.0],"rect":[32.0,0.0,32.0,32.0]},{"border":{"color":"border","width":1.0},"fill":"#f59e0b","kind":"rect","radius":[10.0,10.0,10.0,10.0],"rect":[38.0,6.0,20.0,20.0]},{"fill":"transparent","kind":"rect","radius":[9999.0,9999.0,9999.0,9999.0],"rect":[64.0,0.0,32.0,32.0]},{"border":{"color":"border","width":1.0},"fill":"#16a34a","kind":"rect","radius":[10.0,10.0,10.0,10.0],"rect":[70.0,6.0,20.0,20.0]},{"fill":"transparent","kind":"rect","radius":[9999.0,9999.0,9999.0,9999.0],"rect":[0.0,32.0,32.0,32.0]},{"border":{"color":"border","width":1.0},"fill":"#2563eb","kind":"rect","radius":[10.0,10.0,10.0,10.0],"rect":[6.0,38.0,20.0,20.0]},{"fill":"transparent","kind":"rect","radius":[9999.0,9999.0,9999.0,9999.0],"rect":[32.0,32.0,32.0,32.0]},{"border":{"color":"border","width":1.0},"fill":"#7c3aed","kind":"rect","radius":[10.0,10.0,10.0,10.0],"rect":[38.0,38.0,20.0,20.0]},{"fill":"transparent","kind":"rect","radius":[9999.0,9999.0,9999.0,9999.0],"rect":[64.0,32.0,32.0,32.0]},{"border":{"color":"border","width":1.0},"fill":"mix(accent-hover, bg-000, 9)","kind":"r