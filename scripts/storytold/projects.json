{
  "_": "Where each storytold project comes from and how its crates become modules of one RavenRS crate. Read by convert.py and merge.py; see the ravenrs-<project> skills.",
  "gridcraft": {
    "repo": "https://github.com/storytold/gridcraft",
    "crate": "crates/ravenrs-sheet",
    "lib": "ravenrs_sheet",
    "sources": [
      {
        "path": "crates/core",
        "module": "base",
        "ident": "gridcraft_core",
        "test_data": "in_place"
      },
      {
        "path": "crates/numfmt",
        "module": "numfmt",
        "ident": "gridcraft_numfmt",
        "test_data": "in_place"
      },
      {
        "path": "crates/formula",
        "module": "formula",
        "ident": "gridcraft_formula",
        "test_data": "in_place"
      },
      {
        "path": "crates/functions",
        "module": "functions",
        "ident": "gridcraft_functions",
        "test_data": "in_place"
      },
      {
        "path": "crates/math",
        "module": "math",
        "ident": "gridcraft_math",
        "test_data": "in_place"
      },
      {
        "path": "crates/model",
        "module": "model",
        "ident": "gridcraft_model",
        "test_data": "in_place"
      },
      {
        "path": "crates/calc",
        "module": "calc",
        "ident": "gridcraft_calc",
        "test_data": "in_place"
      },
      {
        "path": "crates/xlsx",
        "module": "xlsx",
        "ident": "gridcraft_xlsx",
        "test_data": "in_place"
      },
      {
        "path": "crates/chart",
        "module": "chart",
        "ident": "gridcraft_chart",
        "test_data": "in_place"
      },
      {
        "path": "crates/pdf",
        "module": "pdf",
        "ident": "gridcraft_pdf",
        "test_data": "in_place"
      },
      {
        "path": "crates/engine",
        "module": "engine",
        "ident": "gridcraft_engine",
        "test_data": "in_place"
      },
      {
        "path": "crates/cfb",
        "module": "craft::cfb",
        "ident": "craft_cfb",
        "repo": "craft-libs",
        "readme": true
      },
      {
        "path": "crates/csv",
        "module": "craft::csv",
        "ident": "craft_csv",
        "repo": "craft-libs",
        "readme": true
      },
      {
        "path": "crates/offcrypto",
        "module": "craft::offcrypto",
        "ident": "craft_offcrypto",
        "repo": "craft-libs",
        "readme": true
      },
      {
        "path": "crates/opc",
        "module": "craft::opc",
        "ident": "craft_opc",
        "repo": "craft-libs",
        "readme": true
      },
      {
        "path": "crates/sheet",
        "module": "craft::sheet",
        "ident": "craft_sheet",
        "repo": "craft-libs",
        "readme": true
      },
      {
        "path": "crates/xls",
        "module": "craft::xls",
        "ident": "craft_xls",
        "repo": "craft-libs",
        "readme": true
      },
      {
        "path": "crates/xml",
        "module": "craft::xml",
        "ident": "craft_xml",
        "repo": "craft-libs",
        "readme": true
      },
      {
        "path": "crates/zip",
        "module": "craft::zip",
        "ident": "craft_zip",
        "repo": "craft-libs",
        "readme": true
      },
      {
        "path": "crates/media-testkit",
        "module": "craft::media_testkit",
        "ident": "craft_media_testkit",
        "repo": "craft-libs",
        "only": [
          "src/hostile.rs"
        ]
      }
    ],
    "repos": {
      "craft-libs": {
        "repo": "https://github.com/storytold/craft-libs",
        "pinned_by": "the craft-cfb line of the root Cargo.toml of GridCraft, at the GridCraft revision"
      }
    }
  },
  "wordcraft": {
    "repo": "https://github.com/storytold/wordcraft",
    "crate": "crates/ravenrs-word",
    "lib": "ravenrs_word",
    "sources": [
      {
        "path": "crates/geom",
        "module": "geom",
        "ident": "wordcraft_geom",
        "features": {
          "image": true
        }
      },
      {
        "path": "crates/doc",
        "module": "doc",
        "ident": "wordcraft_doc"
      },
      {
        "path": "crates/metafile",
        "module": "metafile",
        "ident": "wordcraft_metafile"
      },
      {
        "path": "crates/docx",
        "module": "docx",
        "ident": "wordcraft_docx"
      },
      {
        "path": "crates/docbin",
        "module": "docbin",
        "ident": "wordcraft_docbin"
      },
      {
        "path": "crates/formats",
        "module": "formats",
        "ident": "wordcraft_formats"
      }
    ]
  },
  "pdfcraft": {
    "repo": "https://github.com/storytold/pdfcraft",
    "crate": "crates/ravenrs-pdf",
    "lib": "ravenrs_pdf",
    "sources": [
      {
        "path": "crates/geom",
        "module": "geom",
        "ident": "pdfcraft_geom",
        "precise": true
      },
      {
        "path": "crates/crypt",
        "module": "crypt",
        "ident": "pdfcraft_crypt",
        "precise": true
      },
      {
        "path": "crates/filters",
        "module": "filters",
        "ident": "pdfcraft_filters",
        "precise": true
      },
      {
        "path": "crates/cos",
        "module": "cos",
        "ident": "pdfcraft_cos",
        "precise": true
      },
      {
        "path": "crates/model",
        "module": "model",
        "ident": "pdfcraft_model",
        "precise": true
      },
      {
        "path": "crates/content",
        "module": "content",
        "ident": "pdfcraft_content",
        "precise": true
      },
      {
        "path": "crates/fonts",
        "module": "fonts",
        "ident": "pdfcraft_fonts",
        "precise": true
      },
      {
        "path": "crates/render",
        "module": "render",
        "ident": "pdfcraft_render",
        "precise": true
      },
      {
        "path": "crates/organize",
        "module": "organize",
        "ident": "pdfcraft_organize",
        "precise": true
      },
      {
        "path": "crates/oracle",
        "module": "testing::oracle",
        "ident": "pdfcraft_oracle",
        "precise": true
      },
      {
        "path": "crates/testkit",
        "module": "testing::testkit",
        "ident": "pdfcraft_testkit",
        "precise": true
      },
      {
        "path": "vendor/hayro",
        "module": "third_party::hayro",
        "ident": "hayro",
        "precise": true,
        "tests": false,
        "features": {
          "embed-fonts": true,
          "embed-cmaps": true,
          "logging": false
        },
        "unit_tests": false
      },
      {
        "path": "vendor/hayro-interpret",
        "module": "third_party::hayro_interpret",
        "ident": "hayro_interpret",
        "precise": true,
        "tests": false,
        "features": {
          "embed-fonts": true,
          "embed-cmaps": true,
          "logging": false
        },
        "replace": [
          {
            "from": "\\bskrifa::",
            "to": "skrifa_047::"
          },
          {
            "from": "\\buse skrifa\\b",
            "to": "use skrifa_047"
          }
        ],
        "unit_tests": false
      },
      {
        "path": "vendor/hayro-syntax",
        "module": "third_party::hayro_syntax",
        "ident": "hayro_syntax",
        "precise": true,
        "tests": false,
        "features": {
          "std": true,
          "images": true,
          "unsafe": true,
          "logging": false
        },
        "replace": [
          {
            "from": "(?m)^#!\\[deny\\(missing_docs\\)\\]$",
            "to": "#![deny(missing_docs)]\n// RavenRS: the crate denies unsafe code; this module has the one transmute of hayro-syntax.\n#![allow(unsafe_code)]"
          }
        ],
        "unit_tests": false
      },
      {
        "path": "vendor/hayro-cmap",
        "module": "third_party::hayro_cmap",
        "ident": "hayro_cmap",
        "precise": true,
        "tests": false,
        "features": {
          "std": true,
          "embed-cmaps": true
        },
        "unit_tests": false
      },
      {
        "path": "vendor/hayro-postscript",
        "module": "third_party::hayro_postscript",
        "ident": "hayro_postscript",
        "precise": true,
        "tests": false,
        "features": {},
        "unit_tests": false
      },
      {
        "path": "vendor/hayro-jbig2",
        "module": "third_party::hayro_jbig2",
        "ident": "hayro_jbig2",
        "precise": true,
        "tests": false,
        "features": {
          "std": true,
          "image": true,
          "simd": true,
          "fearless_simd": true
        },
        "unit_tests": false
      },
      {
        "path": "vendor/lopdf",
        "module": "third_party::lopdf",
        "ident": "lopdf",
        "precise": true,
        "tests": false,
        "features": {
          "chrono": true,
          "chrono-clock": true,
          "rayon": true,
          "async": false,
          "embed_image": false,
          "font_embedding": false,
          "jiff": false,
          "serde": false,
          "time": false,
          "wasm_js": false
        },
        "unit_tests": false
      },
      {
        "path": "vendor/vello_cpu",
        "module": "third_party::vello_cpu",
        "ident": "vello_cpu",
        "precise": true,
        "tests": false,
        "features": {
          "std": true,
          "png": true,
          "u8_pipeline": true,
          "text": false,
          "multithreading": false,
          "f32_pipeline": false,
          "libm": false
        },
        "unit_tests": false
      },
      {
        "path": "vendor/vello_common",
        "module": "third_party::vello_common",
        "ident": "vello_common",
        "precise": true,
        "tests": false,
        "features": {
          "std": true,
          "png": true,
          "libm": false,
          "multithreading": false,
          "pico_svg": false,
          "probe": false
        },
        "unit_tests": false
      }
    ]
  },
  "deckcraft": {
    "repo": "https://github.com/storytold/deckcraft",
    "crate": "crates/ravenrs-deck",
    "lib": "ravenrs_deck",
    "sources": [
      {
        "path": "crates/geom",
        "module": "geom",
        "ident": "deckcraft_geom"
      },
      {
        "path": "crates/color",
        "module": "color",
        "ident": "deckcraft_color"
      },
      {
        "path": "crates/model",
        "module": "model",
        "ident": "deckcraft_model"
      },
      {
        "path": "crates/fonts",
        "module": "fonts",
        "ident": "deckcraft_fonts",
        "replace": [
          {
            "from": "join\\(\"tests/fixtures",
            "to": "join(\"tests/fonts_fixtures"
          },
          {
            "from": "include_str!\\(\"tests/fixtures/",
            "to": "include_str!(\"tests/fonts_fixtures/"
          }
        ],
        "build_rs": true
      },
      {
        "path": "crates/text",
        "module": "text",
        "ident": "deckcraft_text"
      },
      {
        "path": "crates/anim",
        "module": "anim",
        "ident": "deckcraft_anim"
      },
      {
        "path": "crates/render",
        "module": "render",
        "ident": "deckcraft_render"
      },
      {
        "path": "crates/pdf",
        "module": "pdf",
        "ident": "deckcraft_pdf",
        "replace": [
          {
            "from": "crate::third_party::krilla::",
            "to": "krilla::"
          },
          {
            "from": "backend as crate::third_party::krilla\\b",
            "to": "backend as krilla"
          }
        ]
      },
      {
        "path": "crates/pptx",
        "module": "pptx",
        "ident": "deckcraft_pptx"
      },
      {
        "path": "crates/format",
        "module": "format",
        "ident": "deckcraft_format"
      },
      {
        "path": "crates/media",
        "module": "media",
        "ident": "deckcraft_media",
        "replace": [
          {
            "from": "join\\(\"tests/fixtures\"\\)",
            "to": "join(\"tests/media_fixtures\")"
          }
        ]
      },
      {
        "path": "crates/engine",
        "module": "engine",
        "ident": "deckcraft_engine",
        "replace": [
          {
            "from": "Path::new\\(env!\\(\"CARGO_MANIFEST_DIR\"\\)\\)\\.join\\(\"src\"\\)",
            "to": "Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"src/engine\")"
          },
          {
            "from": "f\\.ends_with\\(\"lib\\.rs\"\\)",
            "to": "f.ends_with(\"mod.rs\")"
          }
        ]
      },
      {
        "path": "crates/mcp",
        "module": "mcp",
        "ident": "deckcraft_mcp"
      },
      {
        "path": "crates/metafile",
        "module": "craft::metafile",
        "ident": "craft_metafile",
        "repo": "craft-libs",
        "tests": false,
        "unit_tests": false,
        "features": {
          "write": true
        }
      },
      {
        "path": "crates/pdf",
        "module": "craft::pdf",
        "ident": "craft_pdf",
        "repo": "craft-libs",
        "tests": false,
        "unit_tests": false,
        "features": {
          "write": true,
          "write-simple-text": true,
          "write-pdf": false,
          "read": false,
          "interpret": false,
          "raster": false,
          "filters": false,
          "cos": false,
          "crypt": false
        }
      },
      {
        "path": "crates/media",
        "module": "craft::media",
        "ident": "craft_media",
        "repo": "craft-libs",
        "tests": false,
        "unit_tests": false,
        "features": {
          "bitstream": true,
          "isobmff": true,
          "matroska": true,
          "ogg": true,
          "avi": false,
          "mpegts": false,
          "mxf": false,
          "serde": false
        }
      },
      {
        "path": "crates/audio",
        "module": "craft::audio",
        "ident": "craft_audio",
        "repo": "craft-libs",
        "tests": false,
        "unit_tests": false,
        "features": {
          "aac-decode": false,
          "aac-encode": false,
          "ac3-decode": false,
          "ac3-encode": false,
          "alac-decode": false,
          "alac-encode": false,
          "atomics": false,
          "decode": false,
          "decode-native": false,
          "eac3-encode": false,
          "encode": false,
          "flac-encode": false,
          "mp3-decode": false,
          "mp3-encode": false,
          "mpa-decode": false,
          "pcm-encode": false,
          "peaks": false,
          "rayon": false,
          "serde": false,
          "symphonia": false,
          "lossless-encode": false,
          "opus-decode": true
        }
      },
      {
        "path": "crates/video",
        "module": "craft::video",
        "ident": "craft_video",
        "repo": "craft-libs",
        "tests": false,
        "unit_tests": false,
        "features": {
          "apv": false,
          "apv-decode": false,
          "apv-encode": false,
          "av1-encode": false,
          "dnx": false,
          "h264-encode": false,
          "hevc-encode": false,
          "mpeg2": false,
          "mpeg4": false,
          "mpeg4-encode": false,
          "prores": false,
          "vp8": false,
          "vp8-decode": false,
          "vp8-encode": false,
          "vp9-encode": false,
          "h264": false,
          "hevc": false,
          "vp9": false,
          "av1": false,
          "h264-decode": true,
          "hevc-decode": true,
          "vp9-decode": true,
          "av1-decode": true,
          "threads": true
        }
      },
      {
        "path": "vendor/krilla",
        "module": "third_party::krilla",
        "ident": "krilla",
        "repo": "craft-libs",
        "tests": false,
        "unit_tests": false,
        "precise": true,
        "features": {
          "raster-images": true,
          "simple-text": true,
          "pdf": false,
          "comemo": false
        },
        "replace": [
          {
            "from": "feature\\s*=\\s*\"rayon\"",
            "to": "not(target_arch = \"wasm32\")"
          },
          {
            "from": "\\bskrifa::",
            "to": "skrifa_042::"
          },
          {
            "from": "(?m)^#!\\[deny\\(missing_docs\\)\\]$",
            "to": "#![deny(missing_docs)]\n// RavenRS: krilla 0.8.2 uses the std::f32 constants newer compilers deprecate.\n#![allow(deprecated)]"
          }
        ]
      }
    ],
    "repos": {
      "craft-libs": {
        "repo": "https://github.com/storytold/craft-libs",
        "pinned_by": "the craft-media line of the root Cargo.toml of DeckCraft, at the DeckCraft revision"
      }
    }
  }
}
